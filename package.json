{
  "name": "@maida-ai/core",
  "version": "0.6.0",
  "description": "TypeScript mirror for Maida write-side trace events and local-first run storage.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maida-ai/maida-ts.git"
  },
  "homepage": "https://github.com/maida-ai/maida-ts#readme",
  "bugs": "https://github.com/maida-ai/maida-ts/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "maida",
    "behavioral-regression",
    "ci-gate",
    "tracing",
    "ai-agents",
    "local-first"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "js-yaml": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
